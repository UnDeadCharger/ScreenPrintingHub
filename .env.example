# Copy to .env. One file serves local dev (API + Vite read it) and production (docker compose reads it).

# Interface the API and the Vite dev server bind to. 0.0.0.0 = reachable over Tailscale.
HOST=0.0.0.0
# API port. In production this is the single published port (web app + API + images).
API_PORT=3000

# --- Dev only ---
# Vite dev server port. Open http://<tailscale-ip>:5173 on the phone.
WEB_PORT=5173
# Extra hostnames the Vite dev server accepts, comma-separated. IPs always work;
# MagicDNS names must be listed (".ts.net" covers every full tailnet name).
WEB_ALLOWED_HOSTS=.ts.net
# MongoDB connection string. Ignored in production (docker-compose.yml builds its own).
MONGO_URI=mongodb://127.0.0.1:27017/screenprinting
# Where uploaded images are stored. Relative paths resolve from apps/api.
# Ignored in production (a Docker volume is mounted instead).
UPLOAD_DIR=./uploads

# --- Dev and production ---
# Comma-separated origins allowed to call the API cross-origin, e.g.
# http://100.101.102.103:5173,http://myserver.tailnet-name.ts.net:5173
# Leave empty: dev goes through the Vite proxy and production is same-origin.
CORS_ORIGINS=

# --- Production only ---
# MongoDB root credentials. Use URL-safe characters (letters, digits, - _).
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
